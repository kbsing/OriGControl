<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 深色主题调色板 ============ -->

    <SolidColorBrush x:Key="TextBrush" Color="#ECEEE4" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#C3C8BA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8C9183" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2E27" />

    <!-- 强调色：荧光绿 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C8F25A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#D3F57C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A3316" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#5E6B33" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#10120A" />

    <!-- 分段控件 -->
    <SolidColorBrush x:Key="SegBgBrush" Color="#101210" />
    <SolidColorBrush x:Key="SegHoverBrush" Color="#242821" />
    <SolidColorBrush x:Key="SegSelectedBrush" Color="#C8F25A" />
    <SolidColorBrush x:Key="SegSelectedBorderBrush" Color="#C8F25A" />

    <!-- 卡片 / 下拉 / 胶囊 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#181A17" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22251F" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2A2D26" />
    <SolidColorBrush x:Key="CardBrush" Color="#1E211C" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2C3029" />
    <SolidColorBrush x:Key="InsetBrush" Color="#121411" />
    <SolidColorBrush x:Key="PopupBrush" Color="#20231E" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#363B31" />

    <!-- 开关 -->
    <SolidColorBrush x:Key="TrackBrush" Color="#33382F" />
    <SolidColorBrush x:Key="SwitchThumbOnBrush" Color="#10120A" />
    <SolidColorBrush x:Key="SwitchThumbOffBrush" Color="#8C9183" />

    <!-- 电量 -->
    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#33382F" />
    <SolidColorBrush x:Key="BatteryBarBorderBrush" Color="#3A4034" />
    <SolidColorBrush x:Key="BatteryBarFillBrush" Color="#9CCB3B" />
    <SolidColorBrush x:Key="BatteryBarLowFillBrush" Color="#B8542F" />

    <!-- 图标 -->
    <SolidColorBrush x:Key="IconBrush" Color="#A9B09F" />
    <SolidColorBrush x:Key="IconSubtleBrush" Color="#C3C8BA" />

</ResourceDictionary>
