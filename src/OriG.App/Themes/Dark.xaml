<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 深色主题调色板（夜间用，避免刺眼） ============ -->

    <SolidColorBrush x:Key="TextBrush" Color="#F1F3F6" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#C3C8D0" />
    <SolidColorBrush x:Key="MutedBrush" Color="#98A0AB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#34383F" />

    <SolidColorBrush x:Key="AccentBrush" Color="#6E9BFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A8C2FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2B3A5C" />

    <!-- 分段控件 -->
    <SolidColorBrush x:Key="SegBgBrush" Color="#262A31" />
    <SolidColorBrush x:Key="SegHoverBrush" Color="#333840" />
    <SolidColorBrush x:Key="SegSelectedBrush" Color="#3C424B" />
    <SolidColorBrush x:Key="SegSelectedBorderBrush" Color="#4E555F" />

    <!-- 下拉 / 胶囊 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#262A31" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#31363E" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#3A4049" />
    <SolidColorBrush x:Key="PopupBrush" Color="#23262C" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#3A3F47" />

    <!-- 开关 -->
    <SolidColorBrush x:Key="TrackBrush" Color="#4A505A" />

    <!-- 电量 -->
    <SolidColorBrush x:Key="BatteryTrackBrush" Color="#3A3F47" />
    <SolidColorBrush x:Key="BatteryBarBorderBrush" Color="#4A505A" />
    <SolidColorBrush x:Key="BatteryBarFillBrush" Color="#2E6B45" />
    <SolidColorBrush x:Key="BatteryBarLowFillBrush" Color="#7A3B37" />

    <!-- 图标 -->
    <SolidColorBrush x:Key="IconBrush" Color="#98A0AB" />
    <SolidColorBrush x:Key="IconSubtleBrush" Color="#C3C8D0" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF" />

</ResourceDictionary>
