<Window x:Class="OriG.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OriG Control 设置"
        Width="326"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Deactivated="Window_Deactivated">

    <Grid x:Name="RootGrid" ClipToBounds="False">
        <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False" />

        <Border x:Name="RootCard" Background="#99FFFFFF" CornerRadius="8"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="18,16,18,14">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button Content="返回" Style="{StaticResource FlatButton}"
                        HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <!-- 热键 -->
            <TextBlock Text="全局热键（点输入框后按下组合键）" Style="{StaticResource SectionTitle}" />

            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="循环降噪" Style="{StaticResource BodyText}" />
                <TextBox x:Name="AncHotkeyBox" Grid.Column="1" Width="112" IsReadOnly="True"
                         TextAlignment="Center" VerticalContentAlignment="Center" Height="26"
                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                         Foreground="{DynamicResource TextBrush}" FontSize="12"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" GotFocus="Hotkey_GotFocus" />
            </Grid>

            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="循环均衡器" Style="{StaticResource BodyText}" />
                <TextBox x:Name="EqHotkeyBox" Grid.Column="1" Width="112" IsReadOnly="True"
                         TextAlignment="Center" VerticalContentAlignment="Center" Height="26"
                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                         Foreground="{DynamicResource TextBrush}" FontSize="12"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" GotFocus="Hotkey_GotFocus" />
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="打开面板" Style="{StaticResource BodyText}" />
                <TextBox x:Name="PanelHotkeyBox" Grid.Column="1" Width="112" IsReadOnly="True"
                         TextAlignment="Center" VerticalContentAlignment="Center" Height="26"
                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                         Foreground="{DynamicResource TextBrush}" FontSize="12"
                         PreviewKeyDown="Hotkey_PreviewKeyDown" GotFocus="Hotkey_GotFocus" />
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />

            <!-- 行为 -->
            <CheckBox x:Name="AutoStartBox" Style="{StaticResource Switch}" Content="开机自动启动"
                      Margin="0,0,0,14" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />

            <CheckBox x:Name="LowBatteryBox" Style="{StaticResource Switch}" Content="低电量提醒"
                      Margin="0,0,0,10" Checked="LowBattery_Changed" Unchecked="LowBattery_Changed" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="提醒阈值" Style="{StaticResource BodyText}" Margin="0,0,0,0" />
                <ComboBox x:Name="ThresholdBox" Grid.Column="1" Width="82"
                          Style="{StaticResource Combo}"
                          VerticalContentAlignment="Center" SelectionChanged="Threshold_Changed">
                    <ComboBoxItem Content="10%" Tag="10" />
                    <ComboBoxItem Content="20%" Tag="20" />
                    <ComboBoxItem Content="30%" Tag="30" />
                </ComboBox>
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />

            <!-- 外观 -->
            <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="背景图片" Style="{StaticResource BodyText}" />
                    <TextBlock x:Name="BackgroundImageText" Text="未设置（使用实时模糊）"
                               FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" MaxWidth="170" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择…" Style="{StaticResource FlatButton}"
                            Click="PickBackground_Click" />
                    <Button Content="清除" Style="{StaticResource FlatButton}"
                            Click="ClearBackground_Click" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="设置图片后可正常截图；不设则用实时模糊，此时面板拍不到。"
                       FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="模糊程度" Style="{StaticResource BodyText}" />
                <TextBlock x:Name="BlurValueText" Grid.Column="1" Text="16"
                           FontSize="11" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <Slider x:Name="BlurSlider" Style="{StaticResource SoftSlider}"
                    Minimum="0" Maximum="60" Value="16" Margin="0,0,0,12"
                    ValueChanged="Blur_Changed" />

            <CheckBox x:Name="LiveBlurBox" Style="{StaticResource Switch}" Content="实时模糊"
                      Margin="0,0,0,14" Checked="LiveBlur_Changed" Unchecked="LiveBlur_Changed" />

            <TextBlock Text="主题" Style="{StaticResource SectionTitle}" Margin="2,0,0,7" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="LightChip" Style="{StaticResource Chip}" Content="浅色"
                             GroupName="Theme" Checked="Theme_Checked" />
                <RadioButton x:Name="DarkChip" Style="{StaticResource Chip}" Content="深色"
                             GroupName="Theme" Checked="Theme_Checked" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />

            <!-- 电量样式 -->
            <TextBlock Text="电量显示样式" Style="{StaticResource SectionTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="RingChip" Style="{StaticResource Chip}" Content="圆环"
                             GroupName="BatteryStyle" Checked="BatteryStyle_Checked" />
                <RadioButton x:Name="BarChip" Style="{StaticResource Chip}" Content="电池图标"
                             GroupName="BatteryStyle" Checked="BatteryStyle_Checked" />
            </StackPanel>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AboutText" Grid.Column="0" FontSize="10.5"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="日志" Style="{StaticResource FlatButton}"
                        Click="OpenLog_Click" />
            </Grid>
        </StackPanel>
        </Border>
    </Grid>
</Window>
