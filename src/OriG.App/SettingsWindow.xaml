<Window x:Class="OriG.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OriG Control 设置"
        Width="460"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        Deactivated="Window_Deactivated">

    <Grid x:Name="RootGrid" ClipToBounds="False">
        <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False" />

        <Border x:Name="RootCard" Background="#99FFFFFF" CornerRadius="12"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Margin="12,10,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource IconButton}" Click="Close_Click"
                            ToolTip="返回" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource IconBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <TextBlock Grid.Column="1" Text="设置" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0" />

                    <TextBlock Grid.Column="3" Text="OriG Control" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 页签 -->
                <Border Grid.Row="1" Background="{DynamicResource SegBgBrush}"
                        CornerRadius="10" Padding="3" Margin="14,10,14,0">
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="GeneralTab" Style="{StaticResource TabChip}" Content="通用"
                                     GroupName="SettingsTab" Tag="0" Checked="Tab_Checked" />
                        <RadioButton x:Name="GestureTab" Style="{StaticResource TabChip}" Content="手势"
                                     GroupName="SettingsTab" Tag="1" Checked="Tab_Checked" />
                        <RadioButton x:Name="AudioTab" Style="{StaticResource TabChip}" Content="音频"
                                     GroupName="SettingsTab" Tag="2" Checked="Tab_Checked" />
                        <RadioButton x:Name="AboutTab" Style="{StaticResource TabChip}" Content="关于"
                                     GroupName="SettingsTab" Tag="3" Checked="Tab_Checked" />
                    </UniformGrid>
                </Border>

                <ScrollViewer Grid.Row="2" x:Name="ContentScroller"
                              Style="{StaticResource OverlayScroll}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="14,0,0,0">
                    <Grid Margin="0,0,14,14">

                        <!-- ================= 通用 ================= -->
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock Text="全局热键" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Border Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="循环降噪" Style="{StaticResource RowTitle}" />
                                            <TextBox x:Name="AncHotkeyBox" Grid.Column="1" Width="118"
                                                     Style="{StaticResource HotkeyBox}"
                                                     IsReadOnly="True"
                                                     PreviewKeyDown="Hotkey_PreviewKeyDown"
                                                     GotFocus="Hotkey_GotFocus" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="循环均衡器" Style="{StaticResource RowTitle}" />
                                            <TextBox x:Name="EqHotkeyBox" Grid.Column="1" Width="118"
                                                     Style="{StaticResource HotkeyBox}"
                                                     IsReadOnly="True"
                                                     PreviewKeyDown="Hotkey_PreviewKeyDown"
                                                     GotFocus="Hotkey_GotFocus" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="打开面板" Style="{StaticResource RowTitle}" />
                                            <TextBox x:Name="PanelHotkeyBox" Grid.Column="1" Width="118"
                                                     Style="{StaticResource HotkeyBox}"
                                                     IsReadOnly="True"
                                                     PreviewKeyDown="Hotkey_PreviewKeyDown"
                                                     GotFocus="Hotkey_GotFocus" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="点输入框后按下组合键，Backspace 清除"
                                       Style="{StaticResource RowSub}" Margin="4,6,0,0" />

                            <TextBlock Text="启动与连接" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="登录 Windows 后在托盘常驻" Style="{StaticResource RowSub}" />
                                            </StackPanel>
                                            <CheckBox x:Name="AutoStartBox" Grid.Column="1"
                                                      Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center"
                                                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="闲置自动断开" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="面板关闭后断开省电，操作时自动重连"
                                                           Style="{StaticResource RowSub}" />
                                            </StackPanel>
                                            <ComboBox x:Name="IdleDisconnectBox" Grid.Column="1" Width="104"
                                                      Style="{StaticResource Combo}"
                                                      VerticalAlignment="Center"
                                                      SelectionChanged="IdleDisconnect_Changed">
                                                <ComboBoxItem Content="从不" Tag="0" />
                                                <ComboBoxItem Content="5 分钟" Tag="5" />
                                                <ComboBoxItem Content="10 分钟" Tag="10" />
                                                <ComboBoxItem Content="30 分钟" Tag="30" />
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="电量提醒" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="低电量提醒" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="任一耳机低于阈值时发送系统通知"
                                                           Style="{StaticResource RowSub}" />
                                            </StackPanel>
                                            <CheckBox x:Name="LowBatteryBox" Grid.Column="1"
                                                      Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center"
                                                      Checked="LowBattery_Changed" Unchecked="LowBattery_Changed" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,9,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="提醒阈值" Style="{StaticResource RowSub}"
                                                           Margin="0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ThresholdValueText" Grid.Column="1"
                                                           Text="20%" FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="ThresholdSlider" Style="{StaticResource SoftSlider}"
                                                    Minimum="5" Maximum="50" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" Margin="0,7,0,0"
                                                    ValueChanged="Threshold_Changed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="面板" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource GroupCard}">
                                <Border Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="电量显示样式" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="面板中左右耳电量的呈现方式"
                                                       Style="{StaticResource RowSub}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <RadioButton x:Name="RingChip" Style="{StaticResource Chip}"
                                                         Content="圆环" GroupName="BatteryStyle"
                                                         Checked="BatteryStyle_Checked" />
                                            <RadioButton x:Name="BarChip" Style="{StaticResource Chip}"
                                                         Content="电池" GroupName="BatteryStyle"
                                                         Checked="BatteryStyle_Checked" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Border>

                            <TextBlock Text="外观" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="主题" Style="{StaticResource RowTitle}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <RadioButton x:Name="LightChip" Style="{StaticResource Chip}"
                                                             Content="浅色" GroupName="Theme"
                                                             Checked="Theme_Checked" />
                                                <RadioButton x:Name="DarkChip" Style="{StaticResource Chip}"
                                                             Content="深色" GroupName="Theme"
                                                             Checked="Theme_Checked" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="背景图片" Style="{StaticResource RowTitle}" />
                                                <TextBlock x:Name="BackgroundImageText" Text="未设置"
                                                           Style="{StaticResource RowSub}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="190"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="选择…" Style="{StaticResource FlatButton}"
                                                        Click="PickBackground_Click" />
                                                <Button Content="清除" Style="{StaticResource FlatButton}"
                                                        Click="ClearBackground_Click" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,9,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="背景模糊程度" Style="{StaticResource RowSub}"
                                                           Margin="0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="BlurValueText" Grid.Column="1" Text="16"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <Slider x:Name="BlurSlider" Style="{StaticResource SoftSlider}"
                                                    Minimum="0" Maximum="60" Value="16"
                                                    Margin="0,7,0,0" ValueChanged="Blur_Changed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= 手势 ================= -->
                        <StackPanel x:Name="GesturePanel" Visibility="Collapsed">
                            <Border Background="{DynamicResource SegBgBrush}" CornerRadius="10"
                                    Padding="3" Margin="0,14,0,0">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="LeftSideChip" Style="{StaticResource SideChip}"
                                                 GroupName="TouchSide" Content="左耳"
                                                 Checked="TouchSide_Checked" />
                                    <RadioButton x:Name="RightSideChip" Style="{StaticResource SideChip}"
                                                 GroupName="TouchSide" Content="右耳"
                                                 Checked="TouchSide_Checked" />
                                </UniformGrid>
                            </Border>

                            <TextBlock x:Name="TouchSideLabel" Text="左耳触控"
                                       Style="{StaticResource GroupLabel}" />

                            <StackPanel x:Name="TouchEditorPanel">
                                <Border x:Name="LeftTouchCard" Style="{StaticResource GroupCard}">
                                    <StackPanel x:Name="LeftTouchPanel" />
                                </Border>
                                <Border x:Name="RightTouchCard" Style="{StaticResource GroupCard}"
                                        Visibility="Collapsed">
                                    <StackPanel x:Name="RightTouchPanel" />
                                </Border>
                                <TextBlock Text="开关用于启用或禁用该手势，改动会立即写入耳机。"
                                           Style="{StaticResource RowSub}" Margin="4,8,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ================= 音频 ================= -->
                        <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                            <StackPanel x:Name="HeadsetPanel">
                                <TextBlock Text="耳机音频" Style="{StaticResource GroupLabel}" />
                                <Border Style="{StaticResource GroupCard}">
                                    <StackPanel>
                                        <Border Padding="0,9,0,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="提示音音量" Style="{StaticResource RowTitle}" />
                                                    <TextBlock x:Name="ToneValueText" Grid.Column="1" Text="—"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider x:Name="ToneSlider" Style="{StaticResource SoftSlider}"
                                                        Minimum="0" Maximum="16" TickFrequency="1"
                                                        IsSnapToTickEnabled="True" Margin="0,7,0,0"
                                                        ValueChanged="Tone_Changed" />
                                            </StackPanel>
                                        </Border>
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                        <Border Padding="0,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="当前编码" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="由耳机与系统协商，只读"
                                                               Style="{StaticResource RowSub}" />
                                                </StackPanel>
                                                <TextBlock x:Name="CodecValueText" Grid.Column="1" Text="未读取"
                                                           Style="{StaticResource RowValue}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                        <Border Padding="0,9">
                                            <StackPanel>
                                                <TextBlock Text="降噪循环" Style="{StaticResource RowTitle}" />
                                                <TextBlock x:Name="TouchCycleText" Text="未读取"
                                                           Style="{StaticResource RowSub}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="HeadsetHintText" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="4,8,0,0" />
                        </StackPanel>

                        <!-- ================= 关于 ================= -->
                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                            <TextBlock Text="设备" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="设备名称" Style="{StaticResource RowTitle}" />
                                            <TextBlock x:Name="DeviceNameValueText" Grid.Column="1"
                                                       Text="原道耳机" Style="{StaticResource RowValue}"
                                                       MaxWidth="240" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="固件版本" Style="{StaticResource RowTitle}" />
                                            <TextBlock x:Name="FirmwareValueText" Grid.Column="1"
                                                       Text="未读取" Style="{StaticResource RowValue}"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="应用" Style="{StaticResource GroupLabel}" />
                            <Border Style="{StaticResource GroupCard}">
                                <StackPanel>
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="版本" Style="{StaticResource RowTitle}" />
                                            <TextBlock Grid.Column="1" Text="0.1.0"
                                                       Style="{StaticResource RowValue}" />
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <Border Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="运行日志" Style="{StaticResource RowTitle}" />
                                                <TextBlock Text="排查连接问题时可以查看"
                                                           Style="{StaticResource RowSub}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="打开日志"
                                                    Style="{StaticResource FlatButton}"
                                                    VerticalAlignment="Center"
                                                    Click="OpenLog_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="AboutText" FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="8,18,8,0" />
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
