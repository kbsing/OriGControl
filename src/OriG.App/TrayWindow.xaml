<Window x:Class="OriG.App.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OriG Control"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Deactivated="Window_Deactivated">

    <Grid x:Name="RootGrid" ClipToBounds="False">
        <Image x:Name="BackdropImage" Stretch="Fill" IsHitTestVisible="False" />

        <Border x:Name="RootCard" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="20,18,20,16">
            <StackPanel>

                <!-- 头部 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Top"
                            Margin="0,1,0,0">
                        <TextBlock Text="&#xE7F6;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="19" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceNameText" Text="正在连接…"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="—" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BatteryStyleButton" Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Click="BatteryStyle_Click" VerticalAlignment="Top"
                            ToolTip="切换电量显示样式（圆环 / 电池）">
                        <Grid Width="17" Height="17">
                            <Ellipse x:Name="StyleIconRing" Width="14" Height="14"
                                     Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" />
                            <Border x:Name="StyleIconBar" Width="15" Height="9"
                                    CornerRadius="2" BorderBrush="{DynamicResource MutedBrush}"
                                    BorderThickness="1.5" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- 电量 -->
                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,16,0,16" />

                <!-- 降噪分段 -->
                <Border Background="{DynamicResource SegBgBrush}" CornerRadius="16" Padding="5">
                    <UniformGrid x:Name="AncPanel" Columns="4" />
                </Border>

                <!-- 均衡器行 -->
                <ComboBox x:Name="EqCombo" Style="{StaticResource RowCombo}"
                          Margin="0,8,0,0" SelectionChanged="Eq_SelectionChanged" />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,6" />

                <!-- 开关 -->
                <StackPanel x:Name="TogglePanel" />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,2,0,12" />

                <!-- 底部 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SettingsButton" Grid.Column="0" Style="{StaticResource Pill}"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="设置…" FontSize="14" Foreground="{DynamicResource SubtleBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReconnectButton" Grid.Column="1" Margin="10,0,0,0"
                            Style="{StaticResource RoundIcon}" Click="Reconnect_Click"
                            ToolTip="重新连接">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17" Foreground="{DynamicResource IconBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <TextBlock x:Name="HintText" Text="" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Margin="2,8,2,0"
                           HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
